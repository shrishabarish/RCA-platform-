# Database Configuration (LOCAL ONLY - Production access blocked by Hard Guard)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudlens_local
ALLOW_PRODUCTION=0

# AWS Credentials & Configuration (Template / Local Mocks)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_DEFAULT_REGION=eu-north-1

# Platform Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development
CORRELATION_WINDOW_SECONDS=60
LOG_LEVEL=info
CLOUDLENS_MOCK_AWS=true
