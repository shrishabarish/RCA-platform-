# =================================================================
# CLOUDLENS RCA - SECURE ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and enter your real AWS credentials.
# NOTE: '.env' is automatically ignored by Git and will NEVER be shared.
# =================================================================

# AWS Credentials (Optional for local testing, Required for Live AWS)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional Session Token (if using AWS Academy / SSO / Temporary STS keys)
# AWS_SESSION_TOKEN=your_session_token_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development
CORRELATION_WINDOW_SECONDS=60
LOG_LEVEL=info
